# Denanta TranSolution Environment Variables Configuration
# Salin file ini sebagai .env dan isi dengan nilai yang sesuai

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_MIDTRANS_CLIENT_KEY=your-midtrans-client-key
VITE_MIDTRANS_SERVER_KEY=your-midtrans-server-key
VITE_WHATSAPP_API_KEY=your-whatsapp-api-key

# Opsional -- set "true" supaya widget "Simulasi Waktu" (biasanya cuma
# tampil di npm run dev) ikut tampil di build produksi/hosting. Berguna
# selama masa testing & demo sidang; hapus/ubah jadi false setelahnya.
VITE_TAMPILKAN_SIMULASI_WAKTU=false
